{
  "manifest_version": 3,
  "name": "MDLDownloader — Medal.tv Bulk Clip Downloader",
  "version": "1.4.0",
  "description": "Detect your Medal.tv account, pick specific games, and download all clips in a dedicated full-page tab as a single MyClips.zip file.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.medal.tv/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MDLDownloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
